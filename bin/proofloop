#!/bin/sh
# Thin launcher: all logic lives in dist/cli.js so commands stay thin and testable.
# Resolve symlinks first: npm links this file into node_modules/.bin.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
dir=$(cd "$(dirname "$self")/.." && pwd)
exec node --disable-warning=ExperimentalWarning "$dir/dist/cli.js" "$@"
