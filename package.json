{
  "name": "@vamsiivarmaa/proofloop",
  "version": "1.0.0-rc.7",
  "description": "Protocol-driven, evidence-based engineering harness and Claude Code plugin",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "proofloop": "bin/proofloop"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test:cov && pnpm build",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vamsivarma27/proofloop.git"
  },
  "homepage": "https://github.com/vamsivarma27/proofloop#readme",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "agent",
    "harness",
    "verification",
    "evidence",
    "ai-coding"
  ],
  "files": [
    "dist",
    "bin",
    "skills",
    "agents",
    "hooks",
    "protocols",
    "templates",
    "examples",
    ".claude-plugin",
    "docs/assets/hero.gif",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
